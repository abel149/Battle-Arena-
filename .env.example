# Web3 Battle Arena Environment Variables Template
# Copy this file to .env or server/.env to configure local or testnet deployments.

# Server port (default: 3001)
PORT=3001

# Path to SQLite database file
ARENA_DB_PATH=./server/data.sqlite

# On-Chain Match Receipts (MatchResult.sol)
# When set, finished matches write directly to the contract.
# If unset, the server falls back to the simulated JSON ledger.
MATCH_RESULT_ADDRESS=
MATCH_RESULT_CHAIN_ID=31337

# On-Chain ARENA Tokens (ERC-20) & Badges (ERC-1155)
# When set, rewards mint on-chain to human players.
ARENA_TOKEN_ADDRESS=
ARENA_BADGES_ADDRESS=
ARENA_CHAIN_ID=31337

# ProofOfChore Parent Oracle contract (optional)
CHORE_ORACLE_ADDRESS=

# RPC node URL (Hardhat local: http://127.0.0.1:8545, Base Sepolia: https://sepolia.base.org)
NODE_HTTP_URL=http://127.0.0.1:8545

# Server wallet private key (default: Hardhat account #0 public test key - do NOT use real funds)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
